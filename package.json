{
  "name": "skyhook-cli",
  "version": "3.0.0",
  "type": "module",
  "description": "Universal Project Intelligence for AI Agents",
  "preferGlobal": true,
  "bin": {
    "skyhook": "skyhook/cli/skyhook.js",
    "skyhook-cmd": "skyhook/cli/skyhook-cmd.js",
    "skyhook-mcp": "skyhook/cli/skyhook-mcp.js",
    "skyhook-merge-driver": "skyhook/cli/skyhook-merge-driver.js"
  },
  "files": [
    "skyhook/**/*",
    "!skyhook/test/**",
    "LICENSE",
    "README.md",
    "TESTING.md"
  ],
  "scripts": {
    "test": "node skyhook/test/run-unit-tests.js",
    "test:unit": "node skyhook/test/run-unit-tests.js",
    "test:integration": "node --test --test-timeout=5000 skyhook/test/server-*.test.js skyhook/test/adr-server-api.test.js skyhook/test/adr-watcher.test.js skyhook/test/dashboard-api.test.js skyhook/test/dashboard-harness.test.js skyhook/test/dark-matter.test.js skyhook/test/mcp-server.test.js",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:pack-smoke": "node skyhook/test/pack-smoke.js",
    "test:release": "npm test && npm run test:pack-smoke",
    "pack:dry-run": "npm pack --dry-run",
    "publish:dry-run": "npm publish --dry-run",
    "prepublishOnly": "npm run test:release"
  },
  "keywords": [
    "ai",
    "agents",
    "project-intelligence",
    "skyhook",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asadayoub/skyhook.git"
  },
  "author": "Asad Ayoub",
  "bugs": {
    "url": "https://github.com/asadayoub/skyhook/issues"
  },
  "homepage": "https://github.com/asadayoub/skyhook#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "wtfnode": "^0.10.1"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "ws": "^8.22.0"
  }
}
